    "supabase.from() - Database queries",
    "supabase.storage - File storage operations",
    "supabase.realtime - Realtime subscriptions",
    "supabase.functions.invoke() - Call edge functions",
    "supabase.rpc() - Call database functions",
    "REST API endpoints (/rest/v1)",
    "GraphQL API endpoint (/graphql/v1)",
