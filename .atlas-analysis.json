  "keyFeatures": [
    "PostgreSQL database with extensions (pgvector, PostGIS)",
    "Authentication & Authorization (JWT, OAuth, MFA)",
    "Auto-generated REST & GraphQL APIs",
    "Realtime subscriptions via websockets",
    "File Storage with S3 compatibility",
    "Edge Functions with Deno runtime",
    "AI & Vector embeddings toolkit",
    "Studio dashboard for management",
    "Self-hosting with Docker",
    "CLI for local development"
  ],
  "publicApiSurface": [
    "createClient() - Initialize Supabase client",
